# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会进入仓库）
# cp .env.example .env

# 出图默认后端通道：内置「图片视频生成」技能（云端腾讯混元生图），走 BUDDY_CLOUD_TOKEN，无需即梦 key。
# 可选值：buddycloudimg（内置混元生图，默认）| jimeng（火山即梦）| openai（需 OPENAI_API_KEY）| none（仅方案不出图）。
IMG_PROVIDER=buddycloudimg
JIMENG_ACCESS_KEY_ID=__YOUR_JIMENG_ACCESS_KEY_ID__
JIMENG_SECRET_ACCESS_KEY=__YOUR_JIMENG_SECRET_ACCESS_KEY__

# 视觉 CV 服务固定值（即梦图片生成 4.0）
JIMENG_REGION=cn-north-1
JIMENG_SERVICE=cv
# 即梦图片生成 4.0 算法名（req_key）
JIMENG_REQ_KEY=t2i_v40_jimeng

# 内置「3D模型与视频特效」技能 · 云端腾讯混元3D 鉴权用 BUDDY_CLOUD_TOKEN（内置技能的会话 JWT）。
# 由 CodeBuddy 客户端 connect_cloud_service 签发，长约 60 天，过期后需重新更新该值。
BUDDY_CLOUD_TOKEN=__YOUR_BUDDY_CLOUD_TOKEN__

# 管理员账户邮箱：命中此邮箱的注册/登录将自动置为管理员。
ADMIN_EMAIL=you@example.com

# 自助重置密码用的共享重置码（忘记密码时用「邮箱 + 重置码 + 新密码」自助重置）。
RESET_CODE=change-me-reset-code

# 邮箱验证码重置（QQ邮箱 SMTP）。SMTP_PASS 是 QQ邮箱 SMTP 授权码（不是邮箱密码）。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=__YOUR_SMTP_AUTH_CODE__
SMTP_FROM=you@example.com

# 匿名出图配额（可选，取消注释后生效）
# ANON_IMG_QUOTA=50
# ANON_IMG_PER_IP=5

# 出图多模型 fallback：按下面顺序依次尝试各出图通道，某通道抖动/额度耗尽自动切下一个；
# 缺省时退化为仅用 IMG_PROVIDER 单通道。取消注释即启用：
# IMG_FALLBACK_ORDER=buddycloudimg,jimeng,openai

# ---------- CORS 跨域白名单（ hardening） ----------
# 仅放行列表内的前端来源调用 API；同源 SPA 不受影响。逗号分隔，留空用默认（含 imagemythos.fun 与本地调试端口）。
# CORS_ALLOW_ORIGINS=https://imagemythos.fun,http://localhost:3000,http://127.0.0.1:3000

# ---------- 国产文本 LLM（通义 / DeepSeek） ----------
# 启用后，分享卡打开时会用国产模型生成更自然的「整体气质总结」，自动替代/增强确定性解读；
# 原有图像通道（混元/即梦/OpenAI）与所有 API key 完全保留，不受影响。
# 未配置时分享卡静默保留原确定性解读，不影响主流程。
# TEXT_LLM_PROVIDER=qwen        # qwen（通义千问）| deepseek | none（默认，不启用）
# QWEN_MODEL=qwen-plus          # 通义模型名（可选）
# DASHSCOPE_API_KEY=__YOUR_DASHSCOPE_KEY__
# DEEPSEEK_MODEL=deepseek-chat  # DeepSeek 模型名（可选）
# DEEPSEEK_API_KEY=__YOUR_DEEPSEEK_KEY__

# 数据备份（可选）
# BACKUP_INTERVAL_H=6
# BACKUP_KEEP=14
# BACKUP_DIR=
