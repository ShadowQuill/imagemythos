# ============================================================
# AI 审美系统 · 单站点 Caddy 配置（中国香港 · 免备案）
# Caddy 自动申请并续期 Let's Encrypt HTTPS 证书。
#
# 使用：
#   1) 把本文件内容写入服务器 /etc/caddy/Caddyfile
#   2) 将 yourdomain.com 改成你的真实域名
#   3) sudo systemctl restart caddy
#   4) 域名 A 记录指向服务器公网 IP
#
# 站点：
#   yourdomain.com  -> Node 后端（127.0.0.1:3000，同源托管前端 + API）
# ============================================================

yourdomain.com {
    # 反向代理到本地 Node 服务；前端静态文件也由 server.js 同源托管
    reverse_proxy 127.0.0.1:3000
}
